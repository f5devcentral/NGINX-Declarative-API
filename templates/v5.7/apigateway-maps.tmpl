# API Gateway maps file - server {{ server }}
# OpenAPI version: {{ declaration.version }}
# Base URI: {{ declaration.location.uri }}
# Strip base URI: {{ declaration.location.apigateway.api_gateway.strip_uri }}

{% for path in declaration.paths %}

{% if declaration.location.apigateway.api_gateway.enforce_bodies %}
# Enforce mandatory request body check
map $request_method-$host-$uri-$http_content_type-$http_content_length $is_request_body_check_{{ server | replace('.','_') | replace('-','_') }}{{ declaration.location.uri | replace('/','_') | replace('-','_') }}{{ path.path | replace('-','_') | replace('/','_') | replace('.','_') | replace('{','_') | replace('}','_') }} {
{% set bodiesToBeChecked = namespace() %}
{% set bodiesToBeChecked.found = false %}
{% for method in path.methods %}
{% if method.details.requestBodyRequired %}
{% set bodiesToBeChecked.found = true %}
{% set prefix = method.method | upper ~ '-' ~ server ~ '-' ~ declaration.location.uri ~ path.path ~ '-' %}
{% set cts = namespace(items=[]) %}
{% for contentType in method.details.requestBodyContentType %}
{% set cts.items = cts.items + ['\\Q' ~ contentType ~ '\\E'] %}
{% endfor %}
  ~^\Q{{ prefix }}\E{% if cts.items %}(?:{{ cts.items | join('|') }}){% endif %}-(?!0+$)[^\s]+$ 1;
{% endif %}
{% endfor %}
  default {% if bodiesToBeChecked.found %}0{% else %}1{% endif %};
}
{% endif %}

{% for method in path.methods %}

{%- set queryStringParms = namespace(allParams = '') %}
{%- for parm in method.parameters -%}
{%- if parm.required | lower == "true" and ( parm.in | lower == "query" or parm.in | lower == "header" ) %}
{%- set queryStringParms.allParams = queryStringParms.allParams + ' ' + parm.name %}
{%- endif %}
{%- endfor %}


{% if queryStringParms.allParams != '' %}


# Required query string parameters for {{ declaration.location.uri }}{{ path.path }} - method {{ method.method|upper }}
map "" $required_params_{{ method.method }}_{{ server | replace('.','_') }}{{ declaration.location.uri | replace('/','_') | replace('-','_') }}{{ path.path | replace('-','_') | replace('/','_') | replace('.','_') | replace('{','_') | replace('}','_') }} {
  default "{{ queryStringParms.allParams | trim }}";
}
{%- endif -%}

{% set allParams = namespace(missing = '') -%}
{% set allParamsValues = namespace(missing = '') -%}
{% for parm in method.parameters -%}
{# --- Mandatory parameters enforcement --- #}
{% if parm.required | lower == "true" %}
{# --- Mandatory query string parameter enforcement --- #}
{% if parm.in | lower == "query" or parm.in | lower == "header" %}

{% set allParams.missing = allParams.missing + "$missing_" + method.method + "_" + server | replace('.','_') | replace('-','_') + declaration.location.uri | replace('/','_') | replace('-','_') + path.path | replace('-','_') | replace('/','_') | replace('.','_') | replace('{','_') | replace('}','_') + "_" + parm.name %}

# Check query string parameter value and set variable to 0 if the value is among allowed ones in the OpenAPI schema enum, 1 if value is wrong
{% if parm.schema.enum %}
{% if parm.in | lower == "query" %}
map $request_method$host$uri-$arg_{{ parm.name }} $wrongvalue_{{ method.method }}_{{ server | replace('.','_') | replace('-','_') }}{{ declaration.location.uri | replace('/','_') | replace('-','_') }}{{ path.path | replace('-','_') | replace('/','_') | replace('.','_') | replace('{','_') | replace('}','_') }}_{{ parm.name }}
{
{% for enum in parm.schema.enum %}
  "{{ method.method | upper }}{{ server }}{{ declaration.location.uri }}{{ path.path }}-{{ enum }}" 0;
{% set allParamsValues.missing = allParamsValues.missing + "$wrongvalue_" + method.method + "_" + server | replace('.','_') + declaration.location.uri | replace('-','_') | replace('/','_') + path.path | replace('-','_') | replace('/','_') | replace('.','_') | replace('{','_') | replace('}','_') + "_" + parm.name + "-" + enum %}
{% endfor %}
  default 1;
}
{% elif parm.in | lower == "header" %}
map $request_method$host$uri-$http_{{ parm.name }} $wrongvalue_{{ method.method }}_{{ server | replace('.','_') | replace('-','_') }}{{ declaration.location.uri | replace('/','_') | replace('-','_') }}{{ path.path | replace('-','_') | replace('/','_') | replace('.','_') | replace('{','_') | replace('}','_') }}_{{ parm.name }}
{
{% for enum in parm.schema.enum %}
  "{{ method.method | upper }}{{ server }}{{ declaration.location.uri }}{{ path.path }}-{{ enum }}" 0;
{% set allParamsValues.missing = allParamsValues.missing + "$wrongvalue_" + method.method + "_" + server | replace('.','_') + declaration.location.uri | replace('-','_') | replace('/','_') + path.path | replace('-','_') | replace('/','_') | replace('.','_') | replace('{','_') | replace('}','_') + "_" + parm.name + "-" + enum %}
{% endfor %}
  default 1;
}
{% endif %}
{% endif %}

# Check query string parameters and set variable to 0 if found, 1 if missing
{% if parm.in | lower == "query" %}
map $request_method$host$uri$arg_{{ parm.name }} $missing_{{ method.method }}_{{ server | replace('.','_') }}{{ declaration.location.uri | replace('/','_') | replace('-','_') }}{{ path.path | replace('-','_') | replace('/','_') | replace('.','_') | replace('{','_') | replace('}','_') }}_{{ parm.name }}
{
  "{{ method.method|upper }}{{ server }}{{ declaration.location.uri }}{{ path.path }}" 1;
  default 0;
}
{% elif parm.in | lower == "header" %}
map $request_method$host$uri-$http_{{ parm.name }} $missing_{{ method.method }}_{{ server | replace('.','_') }}{{ declaration.location.uri | replace('/','_') | replace('-','_') }}{{ path.path | replace('-','_') | replace('/','_') | replace('.','_') | replace('{','_') | replace('}','_') }}_{{ parm.name }}
{
  ~^{{ method.method|upper }}{{ server }}{{ declaration.location.uri }}{{ path.path | regex_replace('{(.*?)}','(.*)') }}-$ 1;
  default 0;
}
{% endif -%}
{% endif -%}
{% endif -%}
{# --- End of mandatory parameters enforcement --- #}
{%- endfor -%}


{% if allParams.missing != '' %}

# Check if all required parameters have been received
map "{{ allParams.missing | trim }}" $any_missing_{{ method.method }}_{{ server | replace('.','_') }}{{ declaration.location.uri | replace('/','_') }}{{ path.path | replace('/','_') | replace('.','_') | replace('{','_') | replace('}','_') }} {
  ~1      1;     # if any digit is 1 one or more required query string parameter is missing
  default 0;     # all required query string parameters present
}
{% endif %}


# Check if all required parameter values have been received
map "{{ allParamsValues.missing | trim }}" $any_values_invalid_{{ method.method }}_{{ server | replace('.','_') }}{{ declaration.location.uri | replace('/','_') }}{{ path.path | replace('/','_') | replace('.','_') | replace('{','_') | replace('}','_') }} {
{% if allParamsValues.missing != '' %}
  ~1      1;     # if any digit is 1 one or more required query string parameter value is invalid
{% endif %}
  default 0;     # all required query string parameters have valid values
}
{%- endfor %}
{% endfor %}