# API Gateway upstream file - server {{ server }}
# OpenAPI version: {{ declaration.version | replace('\n',' ') }}
# Base URI: {{ declaration.location.uri | replace('\n',' ') }}
{% set upstreams_list = declaration.upstreams if declaration.upstreams is defined and declaration.upstreams else ([declaration.upstream] if declaration.upstream else []) %}
{% for u in upstreams_list %}
{% if u and u.name and (u.servers or u.origin) %}

# Destination server: {{ u.destination_server | replace('\n',' ') }}
upstream {{ u.name }} {
    zone {{ u.name }} 64k;
{% if u.servers %}
{% for s in u.servers %}
    server {{ s.origin }}{% if s.resolve %} resolve{% endif %};
{% endfor %}
{% elif u.origin %}
    server {{ u.origin }}{% if u.resolve %} resolve{% endif %};
{% endif %}
{% if u.resolver %}
    include "{{ ncgconfig.nms.resolver_dir }}/{{ u.resolver | replace(" ", "_") }}.conf";
{% endif %}
}
{% endif %}
{% endfor %}
