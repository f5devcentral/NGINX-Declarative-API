# Copy to .env and edit.

# Base URL of the running NGINX Declarative API instance (no trailing slash)
NDAPI_BASE_URL=http://localhost:5000

# API version path segment used by this branch of NGINX-Declarative-API
NDAPI_VERSION=v5.7

# Auth mode: none | basic | apikey
NDAPI_AUTH_MODE=none

# Used when NDAPI_AUTH_MODE=basic
NDAPI_USERNAME=
NDAPI_PASSWORD=

# Used when NDAPI_AUTH_MODE=apikey (sent as: Authorization: Bearer <key>)
NDAPI_API_KEY=

NDAPI_TIMEOUT_SECONDS=30
NDAPI_VERIFY_TLS=true

# MCP transport: stdio | streamable-http
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=8800
